{
  "name": "interview-lens",
  "version": "0.1.0",
  "description": "Transcript assembly and question interpretation for Interview Lens",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "check": "bun run typecheck && bun run lint && bun test",
    "start": "bun run src/cli.tsx"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "typescript": "^5.9.3"
  },
  "bin": {
    "interview-lens": "./src/cli.tsx"
  }
}