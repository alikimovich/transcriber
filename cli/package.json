{
  "name": "interview-lens",
  "version": "0.1.0",
  "description": "Transcript assembly and question interpretation for Interview Lens",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
