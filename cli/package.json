{
  "name": "transcriber",
  "version": "0.1.0",
  "description": "On-device conversation logger: capture, transcribe, and archive meetings",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "check": "bun run typecheck && bun run lint && bun test",
    "start": "bun run src/cli.tsx",
    "build:bin": "bun build --compile src/cli.tsx --outfile dist/transcriber"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "typescript": "^5.9.3",
    "react-devtools-core": "file:./stub/react-devtools-core"
  },
  "bin": {
    "transcriber": "./src/cli.tsx"
  }
}
